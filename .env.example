# Provedor: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (chave em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (chave em https://console.groq.com/keys)
GROQ_API_KEY=cole_sua_chave_aqui

# Opcional: modelos separados para dividir o limite por minuto. Vazio usa o GEMINI_MODEL.
GEMINI_CLASSIFIER_MODEL=
GEMINI_EXTRACTOR_MODEL=

# Ollama (opcional, roda local)
OLLAMA_MODEL=llama3.1

# Database PostgreSQL
DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume

CORS_ORIGINS=http://localhost:3000
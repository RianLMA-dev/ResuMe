# Provedor: gemini | ollama
LLM_PROVIDER=gemini

# Gemini (chave em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (chave em https://console.groq.com/keys)
GROQ_API_KEY=cole_sua_chave_aqui
# Modelo do Resume Optimizer (opcional). Se o Groq tirar o modelo do ar, troque aqui.
GROQ_MODEL=openai/gpt-oss-120b

# Opcional: modelos separados para dividir o limite por minuto. Vazio usa o GEMINI_MODEL.
GEMINI_CLASSIFIER_MODEL=
GEMINI_EXTRACTOR_MODEL=

# Ollama (opcional, roda local)
OLLAMA_MODEL=llama3.1

# Database PostgreSQL
DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume

CORS_ORIGINS=http://localhost:3000

# Demonstração pública (opcional; só para quem publica uma demo, veja docs/demo-publica.md)
# DEMO_MODE=true
# DEMO_AI_PER_SESSION_HOUR=12
# DEMO_AI_PER_IP_HOUR=30
# DEMO_AI_PER_DAY=300
